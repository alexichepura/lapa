# Copy to .env and adjust. Used by the ./ops scripts and by the app (dotenvy).

# Local database (the server has its own .env with PG__URL).
PG__URL="postgresql://postgres:postgres@127.0.0.1:5432/lapa"

# Cargo package names.
SITE_BIN="site"
ADMIN_BIN="admin"
CLI_BIN="cli"

# Deploy target.
TARGET="aarch64-unknown-linux-gnu"
# SERVER_HOST can write SERVER_DIR; ROOT_HOST installs binaries and units.
SERVER_HOST="sozu@server"
ROOT_HOST="root@server"
SSH_PORT=22
SERVER_DIR="/home/lapa-server"

# Backups, relative to the repo root.
BACKUP_DIR="./backups"
BACKUP_KEEP_DAYS=30

SITE_DOMAIN="lapa.chepura.space"
ADMIN_DOMAIN="lapa-admin.chepura.space"
